# Shared
APP_ENV=local
LOG_LEVEL=INFO

# Streamlit frontend
FRONTEND_PORT=8501
BACKEND_BASE_URL=http://localhost:8080
# Local/staged compatibility only; the authenticated AWS frontend does not receive this key.
BACKEND_API_KEY=change-me-locally
FRONTEND_AUTH_REQUIRED=false
OIDC_REDIRECT_URI=http://localhost:8501/oauth2callback
OIDC_SERVER_METADATA_URL=https://example.invalid/.well-known/openid-configuration
OIDC_COOKIE_SECRET=change-me-locally-with-at-least-32-characters

# FastAPI application backend; the API key is automation-only when OIDC is active.
BACKEND_PORT=8080
AUTOMATION_API_KEY_ENABLED=true
AUTOMATION_USER_ID_PREFIXES=deployment-,live-evaluation,load-test-user-
OIDC_AUTH_ENABLED=false
OIDC_METADATA_PROXY_ENABLED=false
OIDC_ISSUER_URL=https://example.invalid
OIDC_JWKS_URL=https://example.invalid/.well-known/jwks.json
OIDC_CLIENT_ID=local-placeholder-client
OIDC_REQUIRED_TOKEN_USE=
FRONTEND_URL=http://localhost:8501
AI_SERVICE_TIMEOUT_SECONDS=90
AI_SERVICE_COMPOSITION_TIMEOUT_SECONDS=25
COACH_TIMEOUT_SECONDS=120
TRACE_RETENTION_DAYS=30
CHAT_RETENTION_DAYS=90
SYNTHETIC_USER_RETENTION_DAYS=30
DURABLE_AGENT_MEMORY_ENABLED=false
POSTGRES_URL=postgresql://coach:coach@localhost:5432/financial_wellness

# Private multi-agent AI service
AI_SERVICE_PORT=8001
AI_SERVICE_BASE_URL=http://localhost:8001
AI_SERVICE_API_KEY=change-me-locally
MODEL_PROVIDER=local_fixture
MODEL_ID=gpt-6-luna
# Set this only in a private environment or AWS Secrets Manager; never commit a real key.
OPENAI_API_KEY=
MODEL_REASONING_EFFORT=low
PROMPT_SET_VERSION=v6
RAG_PROVIDER=local_fixture
EDUCATION_CORPUS_VERSION=investment-education-sg@local-fixture-v1
POLICY_RAG_PROVIDER=local_fixture
POLICY_CORPUS_VERSION=financial-coach-policy-sg@local-fixture-v1
RAG_MINIMUM_SCORE=0.6
MODEL_MAX_TOKENS=1600
# Total input/output usage across planning, answerability, writing and independent review.
# A smaller explicit limit remains enforced; this is separate from per-role output budgets.
MAX_MODEL_TOKENS_PER_RUN=50000
# Normal read window for a model response; shorter explicit overrides remain supported.
MODEL_READ_TIMEOUT_SECONDS=30
# A specialist can make several bounded model calls for planning, evidence and repair.
# The full specialist deadline remains independent of each model call's read timeout.
AGENT_TIMEOUT_SECONDS=45
# Per-role model, reasoning and output budgets. Unlisted roles inherit global settings.
# OpenAI reasoning calls do not accept temperature; changing it has no effect there.
MODEL_ROLE_OVERRIDES={"router":{"reasoning_effort":"low","max_tokens":1800},"dependency_planner":{"reasoning_effort":"low","max_tokens":1000},"agent_spending":{"reasoning_effort":"medium","max_tokens":3200},"agent_budget":{"reasoning_effort":"medium","max_tokens":3200},"agent_goal_strategy":{"reasoning_effort":"medium","max_tokens":3200},"agent_investment_education":{"reasoning_effort":"medium","max_tokens":4000},"synthesizer":{"reasoning_effort":"low","max_tokens":2400},"risk_compliance":{"reasoning_effort":"medium","max_tokens":3000},"education_query_planner":{"reasoning_effort":"low","max_tokens":1600},"education_answerability":{"reasoning_effort":"low","max_tokens":2400},"response_composer":{"reasoning_effort":"low","max_tokens":2400},"action_grounding_review":{"reasoning_effort":"low","max_tokens":1600}}
MAX_DEPENDENCY_ROUNDS=6
MAX_TASK_ATTEMPTS=3

# AWS placeholders
AWS_REGION=ap-southeast-1
SECRETS_MANAGER_PREFIX=/ai-financial-wellness-coach/local
