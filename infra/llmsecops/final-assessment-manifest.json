  "deferred": [
    {
      "id": "DEFER-DR",
      "reason": "Backup restoration and disaster-recovery exercises are not required for the bounded academic demo.",
      "activation_condition": "Required before a production availability or recoverability claim."
    },
    {
      "id": "DEFER-DURABLE-MEMORY",
      "reason": "Request-scoped state is sufficient and durable agent memory remains disabled by policy.",
      "activation_condition": "Requires approved purpose, consent, correction, isolation, encryption, retention, and deletion design."
    },
    {
      "id": "DEFER-MCP-A2A",
      "reason": "Agents and tools share one service owner and runtime, so typed in-process contracts are sufficient.",
      "activation_condition": "Revisit when agents or tools become independently owned or remotely deployed services."
    },
    {
      "id": "DEFER-PRODUCTION",
      "reason": "The project is explicitly assessed as a synthetic-data demonstration, not a production financial service.",
      "activation_condition": "Requires formal privacy, security, legal, operational, and real-data approval."
    },
    {
      "id": "DEFER-REPRESENTATIVE-USERS",
      "reason": "The prepared human study was explicitly deferred from this project scope.",
      "activation_condition": "Required before claiming representative-user validation or approving real users."
    }
