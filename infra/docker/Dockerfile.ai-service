FROM python:3.12-slim-trixie@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/app

WORKDIR /app
COPY apps/ai-service/pyproject.toml ./pyproject.toml
COPY apps/ai-service/app ./app
COPY apps/ai-service/prompts ./prompts
RUN pip install --no-cache-dir .
# The service does not invoke Perl; remove it from the runtime attack surface.
RUN apt-get update && \
    apt-get upgrade -y && \
    groupadd --system app && \
    useradd --system --gid app --create-home --home-dir /home/app app && \
    apt-get purge -y --allow-remove-essential perl-base && \
    rm -rf /var/lib/apt/lists/*

EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health', timeout=3)"

USER app
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001", "--no-access-log"]
