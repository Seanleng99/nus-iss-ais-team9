FROM python:3.12-slim-trixie@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    HOME=/home/app

WORKDIR /app
COPY apps/frontend/pyproject.toml ./pyproject.toml
COPY apps/frontend/client.py ./client.py
COPY apps/frontend/app.py ./app.py
COPY apps/frontend/ui ./ui
COPY apps/frontend/.streamlit ./.streamlit
RUN pip install --no-cache-dir .
# The service does not invoke Perl; remove it from the runtime attack surface.
RUN apt-get update && \
    apt-get upgrade -y && \
    groupadd --system app && \
    useradd --system --gid app --create-home --home-dir /home/app app && \
    apt-get purge -y --allow-remove-essential perl-base && \
    rm -rf /var/lib/apt/lists/*

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health', timeout=3)"

USER app
CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
